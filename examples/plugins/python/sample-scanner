#!/usr/bin/env python3
import json
import sys

if len(sys.argv) > 1 and sys.argv[1] == "capabilities":
    json.dump({
        "schemaVersion": "linux-nixer.plugin-capabilities.v1",
        "name": "sample-python-scanner",
        "version": "0.1.0",
        "author": "linux-nixer",
        "domains": ["custom-finding"],
        "runtimeNeeds": ["python3"],
    }, sys.stdout)
    sys.stdout.write("\n")
    raise SystemExit(0)

sys.stdin.read()
json.dump({
    "schemaVersion": "linux-nixer.scan.v1",
    "items": [{
        "kind": "custom-finding",
        "name": "python-sample",
        "path": "/opt/python-sample",
        "decision": "candidate",
        "reason": "found by python sample plugin",
    }],
}, sys.stdout)
sys.stdout.write("\n")

