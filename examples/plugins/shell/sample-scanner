  cat <<'JSON'
{"schemaVersion":"linux-nixer.plugin-capabilities.v1","name":"sample-shell-scanner","version":"0.1.0","author":"linux-nixer","domains":["custom-finding"],"runtimeNeeds":["shell"]}
