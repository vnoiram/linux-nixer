  exit 0
fi
cat >/dev/null
cat <<'JSON'
{"schemaVersion":"linux-nixer.scan.v1","items":[{"kind":"custom-finding","name":"shell-sample","path":"/opt/shell-sample","decision":"candidate","reason":"found by shell sample plugin"}]}
JSON

